# Simple: copy listed figures into "Figures&Tables"
dest <- "Figures&Tables"
if (!dir.exists(dest)) dir.create(dest, recursive = TRUE)

figs <- c(
  "Movement_dynamics.PNG",
  "Combined_Figures.PNG",
  "Performance_first_5_years_relative_OM_1.PNG",
  "Performance_last_5_years_relative_OM_1.PNG",
  "Catch_variation_OM1.PNG",
  "Probability_Overfished_Overfishing_OM1_MSY.PNG",
  "Holistic_OM_1.PNG"
)

# Copy any that exist; warn on missing
exists_vec <- file.exists(figs)
if (any(exists_vec)) {
  copied <- file.copy(figs[exists_vec], dest, overwrite = TRUE)
  message("Copied: ", paste(basename(figs[exists_vec][copied]), collapse = ", "))
}
if (any(!exists_vec)) {
  message("Not found: ", paste(figs[!exists_vec], collapse = ", "))
}

